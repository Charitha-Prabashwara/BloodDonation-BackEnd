# Ignore node_modules (since dependencies will be installed inside the container)
node_modules/

# Ignore log files
*.log

# Ignore environment variable files (e.g., .env)
.env

# Ignore coverage folder generated by testing frameworks
coverage/

# Ignore Dockerfile (it's not needed in the image itself)
Dockerfile

# Ignore docker-compose.yml (it's not needed in the image itself)
docker-compose.yml

# Ignore any IDE or editor-specific files (e.g., VSCode, JetBrains)
.vscode/
.idea/

# Ignore build output folder (if any)
build/
dist/

# Ignore npm debug log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore any other temporary or cache files
*.swp
*.bak
*.tmp
