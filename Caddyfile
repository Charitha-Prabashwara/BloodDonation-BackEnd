localhost {
    tls internal
    
    # Backend API over HTTPS
    reverse_proxy /api/v1/* backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    # React Vite dev server
    reverse_proxy /* frontend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
